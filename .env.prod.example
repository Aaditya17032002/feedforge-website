# Production — copy to .env.prod (gitignored)
#   cp .env.prod.example .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d

APP_URL=https://feedforge.ai
NEXT_PUBLIC_APP_URL=https://app.feedforge.ai

# Application API on edge_net (same LANDING_PORTAL_API_KEY as Application .env)
BACKEND_INTERNAL_URL=http://feedforge_backend:8000
LANDING_PORTAL_API_KEY=CHANGE_ME_SAME_AS_APPLICATION_ENV

# OpenRouter — paid credits required (try-product + chatbot)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
NEXT_PUBLIC_CHATBOT_ENABLED=true

# GA4 — GA_MEASUREMENT_ID is runtime; NEXT_PUBLIC_* is also baked in at image build
GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cal.com scheduling (chatbot)
CAL_API_KEY=
CAL_USERNAME=
CAL_EVENT_TYPE_ID=
CAL_TIMEZONE=UTC
