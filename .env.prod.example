# Copy to .env.prod for production (never commit .env.prod)
# Must match Application stack: same LANDING_PORTAL_API_KEY value

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@feedforge.ai
DEMO_TEAM_EMAIL=support@feedforge.ai
CONTACT_TEAM_EMAIL=contact@feedforge.ai
APP_URL=http://YOUR_SERVER_IP

# Lead intake → Application API (server-side only)
BACKEND_INTERNAL_URL=http://feedforge_backend:8000
LANDING_PORTAL_API_KEY=CHANGE_ME_SAME_AS_APPLICATION_ENV

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
NEXT_PUBLIC_CHATBOT_ENABLED=false
# GA4 measurement ID (G-XXXXXXXXXX). Omit to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cal.com config
CAL_API_KEY=your_key_here
CAL_USERNAME=yourname
CAL_EVENT_TYPE_ID=123456
# Optional; defaults to UTC
CAL_TIMEZONE=Asia/Kolkata