SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@feedforge.ai
DEMO_TEAM_EMAIL=support@feedforge.ai
CONTACT_TEAM_EMAIL=contact@feedforge.ai
APP_URL=http://localhost:3000
# Server-side lead intake → Application POST /api/v1/leads (must match Application .env)
# Portal pricing → GET /api/v1/portal/pricing (cached on backend; Next.js revalidate 300s)
# Local npm dev: BACKEND_API_URL=http://localhost:8000
# Docker dev (independent of Platform network): BACKEND_INTERNAL_URL=http://host.docker.internal:8000
# Prod on shared edge_net with Platform: BACKEND_INTERNAL_URL=http://feedforge_backend:8000
BACKEND_INTERNAL_URL=
BACKEND_API_URL=http://localhost:8000
LANDING_PORTAL_API_KEY=change-me-to-a-long-random-secret
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
NEXT_PUBLIC_CHATBOT_ENABLED=false
# Base URL of the FeedForge app where /login and /signup live.
# The Header's Log in / Sign up buttons link to ${NEXT_PUBLIC_APP_URL}/login and /signup.
# Falls back to https://app.feedforge.ai if unset.
NEXT_PUBLIC_APP_URL=https://app.feedforge.ai
# GA4 — local npm build uses NEXT_PUBLIC_*; Docker prod also sets GA_MEASUREMENT_ID in .env.prod.
GA_MEASUREMENT_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

CAL_API_KEY=your_key_here
CAL_USERNAME=yourname
CAL_EVENT_TYPE_ID=123456
# Optional; defaults to UTC
CAL_TIMEZONE=Asia/Kolkata