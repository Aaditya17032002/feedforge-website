# Local — copy to .env.local
#   cp .env.example .env.local

APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=https://app.feedforge.ai

# Application API (same LANDING_PORTAL_API_KEY as Application .env)
BACKEND_API_URL=http://localhost:8000
BACKEND_INTERNAL_URL=
LANDING_PORTAL_API_KEY=change-me-to-a-long-random-secret

# OpenRouter — paid credits required (try-product + chatbot)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
NEXT_PUBLIC_CHATBOT_ENABLED=false

# GA4 — omit to disable
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Cal.com scheduling (chatbot)
CAL_API_KEY=
CAL_USERNAME=
CAL_EVENT_TYPE_ID=
CAL_TIMEZONE=UTC
